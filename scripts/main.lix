include "math.lix";
include "util.lix";
include "sort.lix";

// Nested namespaces
namespace a {
    namespace b {
        // println(Object) is called from GLOBAL explicitly
        function c() ::println("Hello from a nested namespace");
    }
}

// Lambda-function for invocation by Java.
function hello() {
    for (static i = 1; i <= 5; i++) {
        println("Hello from a different thread! (x" + i + ")");
    }
}

// Lambda-function for invocation by Java.
function each(string) {
    println("String value " + string);
}

function test_async() {
    async(hello);
    EXECUTOR_SERVICE.shutdown();
}

static var EMPTY_ARRAY = new_array("java.lang.Object", 0);

function test_list() {
    list = new_instance("java.util.ArrayList", EMPTY_ARRAY);
    list.add("1");
    list.add("2");
    list.forEach(each);
}

function test_unassigned(ref) {
    println(ref);
}

function test_static() {
    static a = 0;
    println("Static increment " + (++a));
}

function main() {
    number = 5;
    factor = math::factorial_r(number);
    println("Recursive factorial of " + number + " is " + factor);

    //test_async();
    test_list();

    test_static();
    test_static();

    a::b::c();
    //scanLine();
}
