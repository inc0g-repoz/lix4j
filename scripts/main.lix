include "math.lix";
include "util.lix";

function multithreadable() {
    for (static i = 1; i <= 5; i++) {
        println("Hello from a different thread! (x" + i + ")");
    }
}

function test_async() {
    async(this::multithreadable);
    shutdown_execution_service();
}

function recursive(n) {
    if (n-- < 1) {
        return 1;
    }
    println("went down to " + n);
    return recursive(n);
}

function main() {
    number = 1;
    factor = factorial_r(number);
    println("Recursive factorial of " + number + " is " + factor);
}
