include "math.lix";
include "sort.lix";
include "util.lix";

static var EMPTY_ARRAY = new_array("java.lang.Object", 0);

namespace lambdas {

    function printElement(elt) {
        println("Element: \"" + elt + "\"");
    }

}

function test_list() {
    var list = new_instance("java.util.ArrayList", EMPTY_ARRAY);
    list.add("1");
    list.add("2");
    list.forEach(lambdas::printElement);
}

function main() {
    test_list();
    println(math::factorial(5));

    //var line = scanLine();
    //println("You said \"" + line + "\"");

    //sleep(1000);
}
